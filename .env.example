# Copia este archivo como .env y completa los valores.
# El .env NO se sube a Git: tiene contraseñas.

# Base de datos PostgreSQL en Neon (Dashboard → Connect → connection string).
# Si la dejas comentada, el proyecto usa SQLite local (db.sqlite3).
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Solo en producción:
# DJANGO_SECRET_KEY=una-clave-larga-y-secreta
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=woof.onrender.com
